{
  "name": "notsofarji",
  "version": "0.1.0",
  "private": true,
  "description": "NotSoFarji — a lifecycle-aware blockchain verification system for professional claims. Because your resume should not be farji.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "hardhat:compile": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat compile",
    "hardhat:test": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat test",
    "hardhat:node": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat node",
    "hardhat:deploy:local": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat run scripts/deploy.ts --network localhost"
  },
  "dependencies": {
    "ethers": "^6.13.0",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.0.2",
    "@types/node": "^20.14.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "hardhat": "^2.22.6",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vitest": "^2.0.4"
  }
}
