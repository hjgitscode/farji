# Copy to .env.local (local) or enter these in the Vercel project settings (hosted). Never commit real values.
# `npm run env:check` validates your environment by NAME and rule only (it never prints a value).
# The full matrix, with where each value comes from, is in docs/DEPLOYMENT.md.

# ── Site URLs ──
# NEXT_PUBLIC_APP_URL: the site origin used in email-confirmation links (public; inlined into the build).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# FARJI_PUBLIC_URL: authoritative origin for share links, QR codes and evidence links (e.g. https://farji.example).
# Set it to the same origin as NEXT_PUBLIC_APP_URL in production. No path, no trailing path segments.
FARJI_PUBLIC_URL=

# ── Database (Supabase PostgreSQL via Prisma) ──
# Server-only. Never prefix with NEXT_PUBLIC_.
# DATABASE_URL: pooled connection string (Supabase "Transaction pooler", port 6543) - the app uses this at runtime.
# DIRECT_URL: session pooler / direct string (port 5432) - used only by `npm run db:migrate`.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# ── Supabase Auth (PUBLIC values only) ──
# Project Settings > API: the project URL and the PUBLISHABLE key (sb_publishable_...). The legacy anon key name
# NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted. NEVER put a secret / service-role key in any variable here.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-publishable-key>

# ── Blockchain (server-side; there is NO default for any of these) ──
# Every environment (local, preview, production) must use its OWN FarjiRegistry deployment. The server never holds a private key.
# FARJI_CHAIN_ID: 11155111 (Sepolia) in production. Local networks are 31337 / 1337. Ethereum mainnet is not supported.
FARJI_CHAIN_ID=
# FARJI_REGISTRY_ADDRESS: the deployed FarjiRegistry (printed by `npm run chain:deploy:sepolia`).
FARJI_REGISTRY_ADDRESS=
# FARJI_RPC_URL: any standard JSON-RPC URL for that chain (a public Sepolia endpoint works). It may contain a provider key,
# so keep it server-side: never prefix it NEXT_PUBLIC_.
FARJI_RPC_URL=
# FARJI_FINALITY: "finalized" on Sepolia (required). "depth:N" is for local nodes only (depth:0 dev, depth:2 tests).
FARJI_FINALITY=finalized
# FARJI_ADMIN_WALLET: the PUBLIC address of the Admin's MetaMask wallet (platform admin). Used by the deployment script.
FARJI_ADMIN_WALLET=
# FARJI_DEFAULT_ADMIN (optional, deployment only): a PUBLIC address allowed to grant/revoke the platform-admin role.
# Defaults to FARJI_ADMIN_WALLET so the throw-away deployer holds no authority.
FARJI_DEFAULT_ADMIN=
# FARJI_ADMIN_DELAY_SECONDS (optional, deployment only): delay for admin-role changes. Minimum 86400 on a public network.
FARJI_ADMIN_DELAY_SECONDS=

# ── Scheduled chain sync ──
# Shared bearer token that protects /api/chain/sync. Use 32+ random characters (e.g. `openssl rand -base64 36`). If unset the
# route refuses every request. On Vercel, set CRON_SECRET to the SAME value so Vercel Cron sends it automatically.
# (Named *_TOKEN on purpose: the project forbids reading any *SECRET* environment variable.)
FARJI_SYNC_TOKEN=
# FARJI_APP_URL: the app origin that `npm run chain:sync` (and the optional GitHub Action) calls. Operator tooling only.
FARJI_APP_URL=

# ── Optional tooling / hosting switches ──
# FARJI_TRUST_PROXY=1: believe X-Forwarded-For / X-Real-IP for rate limiting when NOT running on Vercel behind a proxy you control.
FARJI_TRUST_PROXY=
# FARJI_DEPLOYER_KEYSTORE: path of the encrypted deployer keystore (default .keystore/deployer.json, git-ignored).
FARJI_DEPLOYER_KEYSTORE=
# FARJI_CHECK_MODE=development: lets `npm run env:check` accept a local setup (local chain, http URLs).
FARJI_CHECK_MODE=
