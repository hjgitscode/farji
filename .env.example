# Copy to .env.local and fill in. Never commit real values.
# Phase 1 only needs the public site URL; later phases add their own variables.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database (Supabase PostgreSQL via Prisma) ──
# Server-only. Never prefix with NEXT_PUBLIC_. Never commit real values.
# DATABASE_URL: pooled connection string (Supabase "Transaction pooler", port 6543).
#   Add ?pgbouncer=true&connection_limit=1 if you use the pooler from serverless.
# DIRECT_URL: direct or session-pooler connection (port 5432) used by Prisma Migrate.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# ── Supabase Auth (PUBLIC values only) ──
# Project Settings → API. Use the project URL and the PUBLISHABLE key (sb_publishable_…)
# or the legacy anon key. NEVER put a secret / service-role key in any variable here —
# the app refuses to start auth with one. Server-only secrets must not be prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-publishable-key>

# -- Credential signing (EIP-712 domain, Phase 6) --
# Server-only. There is NO default: issuance is disabled until both are set. Every environment
# (local, preview, production) must use its OWN FarjiRegistry deployment so signatures cannot be
# replayed across environments. Never put a private key here: the server never holds one.
FARJI_CHAIN_ID=
FARJI_REGISTRY_ADDRESS=

# Shared bearer token that protects POST /api/chain/sync (scheduled chain sync). Use 16+ random
# characters; if unset the route refuses every request. (Named *_TOKEN on purpose: the project
# forbids reading any *SECRET* environment variable.)
FARJI_SYNC_TOKEN=
FARJI_FINALITY=finalized
FARJI_RPC_URL=
FARJI_ADMIN_WALLET=
