# Copy to .env.local and fill in. Never commit real values.
# Phase 1 only needs the public site URL; later phases add their own variables.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database (Supabase PostgreSQL via Prisma) ──
# Server-only. Never prefix with NEXT_PUBLIC_. Never commit real values.
# DATABASE_URL: pooled connection string (Supabase "Transaction pooler", port 6543).
#   Add ?pgbouncer=true&connection_limit=1 if you use the pooler from serverless.
# DIRECT_URL: direct or session-pooler connection (port 5432) used by Prisma Migrate.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
